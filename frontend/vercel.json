{
  "rewrites": [
    {
      "source": "/proxy/:path*",
      "destination": "https://api.duytu205.id.vn/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.duytu205.id.vn/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
